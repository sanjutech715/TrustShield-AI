# Copy this file to .env and fill in values as needed.
# TrustShield AI works completely WITHOUT a Gemini key — the rule-based
# risk engine is the primary analyzer and is always available offline.
# If GEMINI_API_KEY is left blank, the app will say so in every response
# (analyzer_used: "rule_based") instead of pretending AI ran.

GEMINI_API_KEY=

# SQLite file used to store (local, anonymous) analysis history for the
# "Security Status Dashboard" counters. Safe to delete at any time.
DATABASE_PATH=trustshield.db

# Comma-separated list of origins allowed to call this API (your frontend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
